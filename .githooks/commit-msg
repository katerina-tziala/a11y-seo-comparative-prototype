#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: commit-msg <message-file>" >&2
  exit 1
fi

first_line=$(sed -n '1p' "$1")

case "$first_line" in
  'Merge '*|'Revert '*) exit 0 ;;
esac

pattern='^(a11y\(CF[0-9]{2}\)|(feat|fix|chore|eval|docs)(\((CF[0-9]{2}|[a-z][a-z0-9-]*)\))?): [^[:space:]].*$'

if printf '%s\n' "$first_line" | LC_ALL=C grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
Invalid commit message first line.
Allowed: a11y(CFxx): description (CF followed by exactly two digits).
Or: feat, fix, chore, eval, docs, optionally scoped with CFxx or a lowercase
name containing digits and hyphens (starting with a lowercase letter).
Use ': ' followed by a nonempty description. Merge and Revert messages are allowed.
Example: a11y(CF09): add a text alternative to the diagram
EOF
exit 1
