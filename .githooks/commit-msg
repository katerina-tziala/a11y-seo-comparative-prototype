#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: commit-msg <message-file>" >&2
  exit 1
fi

first_line=$(sed -n '1p' "$1")

case "$first_line" in
  'Merge '*|'Revert '*) exit 0 ;;
esac

pattern='^(a11y\(AR(0[1-9]|[1-3][0-9]|4[0-8])\)|(feat|fix|chore|eval|docs)(\((AR(0[1-9]|[1-3][0-9]|4[0-8])|[a-z][a-z0-9-]*)\))?): [^[:space:]].*$'

if printf '%s\n' "$first_line" | LC_ALL=C grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
Invalid commit message first line.
Allowed: a11y(ARxx): description (AR01 through AR48).
Or: feat, fix, chore, eval, docs, optionally scoped with AR01 through AR48 or a lowercase
name containing digits and hyphens (starting with a lowercase letter).
Use ': ' followed by a nonempty description. Merge and Revert messages are allowed.
Example: a11y(AR11): add a text alternative to the diagram
EOF
exit 1
